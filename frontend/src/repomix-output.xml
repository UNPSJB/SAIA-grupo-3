import { Table, Card, Button, Badge } from 'react-bootstrap';
import { usePersonal } from './usePersonal';
import { LoadingSpinner } from '../../shared/components/LoadingSpinner';
import { ErrorAlert } from '../../shared/components/ErrorAlert';
