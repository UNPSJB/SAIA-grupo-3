                    </td>
                    <td className="text-center">
                      <div className="d-flex justify-content-center gap-2">                      
                        <Button variant="primary" size="sm" className="text-white py-1 px-2 shadow-sm" title="Ver" onClick={() => onViewClick(p)}>
