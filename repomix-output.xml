  mostrarInactivos = false,
  ordenarPor = 'id',
  orden = 'asc'
): Promise<PaginatedEquipos> {
  const res = await fetch(`${API_BASE_URL}/equipos?page=${page}&size=${size}&mostrar_inactivos=${mostrarInactivos}&ordenar_por=${ordenarPor}&orden=${orden}`);
